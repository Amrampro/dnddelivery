{
  "name": "dnd-delivery-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --localhost",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform all",
    "doctor": "expo-doctor",
    "check:dependencies": "expo install --check",
    "start:clear": "expo start --clear --localhost",
    "test": "tsx --test tests/*.test.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.33",
    "expo-constants": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.2.4",
    "eslint": "^10.13.0",
    "expo-doctor": "^1.21.5",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "overrides": {
    "minimatch@>=7": "11.0.1",
    "glob@>=9": "14.0.6",
    "node-forge": "1.4.3"
  }
}
