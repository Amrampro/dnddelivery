generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum AccountStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum RoleScope {
  GLOBAL
  COMPANY
  AGENCY
  SHOP
}

enum CollaborationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  ENDED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  TOKEN_REVOKED
  PASSWORD_RESET
  PERMISSIONS_CHANGED
}

enum StockMovementType {
  DEPOSIT
  ISSUE
  RESERVE
  RELEASE
  ADJUSTMENT
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum OrderType {
  ONE_OFF
  FROM_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  IN_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  FAILED
  CANCELLED
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  REVOKED
  CONSUMED
}

enum ProofMethod {
  OTP
  AUTHORIZED_EXCEPTION
}

enum CollectionStatus {
  PENDING
  DECLARED
  VERIFIED
  DISPUTED
  VOIDED
}

enum PaymentMethod {
  CASH
  MTN_MOBILE_MONEY
  ORANGE_MONEY
  BANK_TRANSFER
  OTHER
}

enum RemittanceStatus {
  DECLARED
  CONFIRMED
  DISPUTED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum DeclarationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum Visibility {
  PRIVATE
  COMPANY
}

model User {
  id                            String              @id @default(uuid()) @db.Char(36)
  email                         String              @unique @db.VarChar(254)
  passwordHash                  String              @db.VarChar(255)
  fullName                      String              @db.VarChar(160)
  phone                         String?             @db.VarChar(32)
  status                        AccountStatus       @default(ACTIVE)
  emailVerifiedAt               DateTime?           @db.DateTime(3)
  archivedAt                    DateTime?           @db.DateTime(3)
  createdAt                     DateTime            @default(now()) @db.DateTime(3)
  updatedAt                     DateTime            @updatedAt @db.DateTime(3)
  globalRoleGrant_userRecords   GlobalRoleGrant[]   @relation("GlobalRoleGrant_user")
  companyMembership_userRecords CompanyMembership[] @relation("CompanyMembership_user")
  shopMembership_userRecords    ShopMembership[]    @relation("ShopMembership_user")
  session_userRecords           Session[]           @relation("Session_user")
  accountToken_userRecords      AccountToken[]      @relation("AccountToken_user")
  authEvent_userRecords         AuthEvent[]         @relation("AuthEvent_user")
  order_creatorRecords          Order[]             @relation("Order_creator")
  stockMovement_actorRecords    StockMovement[]     @relation("StockMovement_actor")
  orderEvent_actorRecords       OrderEvent[]        @relation("OrderEvent_actor")
  deliveryEvent_actorRecords    DeliveryEvent[]     @relation("DeliveryEvent_actor")
  fileAsset_uploaderRecords     FileAsset[]         @relation("FileAsset_uploader")
  collectionEvent_actorRecords  CollectionEvent[]   @relation("CollectionEvent_actor")
  remittanceEvent_actorRecords  RemittanceEvent[]   @relation("RemittanceEvent_actor")
  userDevice_userRecords        UserDevice[]        @relation("UserDevice_user")
  notification_recipientRecords Notification[]      @relation("Notification_recipient")
  auditLog_actorRecords         AuditLog[]          @relation("AuditLog_actor")
}

model Role {
  id                            String              @id @default(uuid()) @db.Char(36)
  code                          String              @unique @db.VarChar(60)
  name                          String              @db.VarChar(120)
  scope                         RoleScope
  createdAt                     DateTime            @default(now()) @db.DateTime(3)
  updatedAt                     DateTime            @updatedAt @db.DateTime(3)
  rolePermission_roleRecords    RolePermission[]    @relation("RolePermission_role")
  globalRoleGrant_roleRecords   GlobalRoleGrant[]   @relation("GlobalRoleGrant_role")
  companyMembership_roleRecords CompanyMembership[] @relation("CompanyMembership_role")
  agencyMembership_roleRecords  AgencyMembership[]  @relation("AgencyMembership_role")
  shopMembership_roleRecords    ShopMembership[]    @relation("ShopMembership_role")

  @@unique([id, scope])
}

model Permission {
  id                               String           @id @default(uuid()) @db.Char(36)
  code                             String           @unique @db.VarChar(100)
  description                      String           @db.VarChar(255)
  createdAt                        DateTime         @default(now()) @db.DateTime(3)
  updatedAt                        DateTime         @updatedAt @db.DateTime(3)
  rolePermission_permissionRecords RolePermission[] @relation("RolePermission_permission")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Char(36)
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @db.DateTime(3)
  role         Role       @relation("RolePermission_role", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission @relation("RolePermission_permission", fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([roleId, permissionId])
}

model GlobalRoleGrant {
  id                                   String                @id @default(uuid()) @db.Char(36)
  userId                               String                @unique @db.Char(36)
  roleId                               String                @db.Char(36)
  roleScope                            RoleScope             @default(GLOBAL)
  active                               Boolean               @default(true)
  createdAt                            DateTime              @default(now()) @db.DateTime(3)
  updatedAt                            DateTime              @updatedAt @db.DateTime(3)
  user                                 User                  @relation("GlobalRoleGrant_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role                                 Role                  @relation("GlobalRoleGrant_role", fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)
  subscriptionPayment_validatorRecords SubscriptionPayment[] @relation("SubscriptionPayment_validator")
  subscriptionEvent_actorRecords       SubscriptionEvent[]   @relation("SubscriptionEvent_actor")
}

model Company {
  id                                 String                @id @default(uuid()) @db.Char(36)
  reference                          String                @unique @db.VarChar(50)
  name                               String                @db.VarChar(160)
  email                              String                @db.VarChar(254)
  phone                              String                @db.VarChar(32)
  address                            String                @db.VarChar(500)
  city                               String                @db.VarChar(120)
  countryCode                        String                @db.Char(2)
  tradeName                          String?               @db.VarChar(160)
  registrationNumber                 String?               @db.VarChar(100)
  description                        String?               @db.VarChar(2000)
  logoKey                            String?               @db.VarChar(80)
  version                            Int                   @default(1)
  administrativeReason               String?               @db.VarChar(500)
  statusChangedAt                    DateTime?             @db.DateTime(3)
  statusChangedById                  String?               @db.Char(36)
  primaryAdminUserId                 String?               @db.Char(36)
  // Composite FK to CompanyMembership is enforced by SQL. Do not model it through id:
  // optional composite relations sharing a generated primary key suppress Prisma's UUID default.
  invitations                        CompanyInvitation[]
  status                             OrganizationStatus    @default(INACTIVE)
  archivedAt                         DateTime?             @db.DateTime(3)
  createdAt                          DateTime              @default(now()) @db.DateTime(3)
  updatedAt                          DateTime              @updatedAt @db.DateTime(3)
  companyMembership_companyRecords   CompanyMembership[]   @relation("CompanyMembership_company")
  agency_companyRecords              Agency[]              @relation("Agency_company")
  agencyMembership_companyRecords    AgencyMembership[]    @relation("AgencyMembership_company")
  companyShop_companyRecords         CompanyShop[]         @relation("CompanyShop_company")
  stock_companyRecords               Stock[]               @relation("Stock_company")
  transfer_companyRecords            Transfer[]            @relation("Transfer_company")
  transferItem_companyRecords        TransferItem[]        @relation("TransferItem_company")
  transferEvent_companyRecords       TransferEvent[]       @relation("TransferEvent_company")
  recipient_companyRecords           Recipient[]           @relation("Recipient_company")
  order_companyRecords               Order[]               @relation("Order_company")
  orderItem_companyRecords           OrderItem[]           @relation("OrderItem_company")
  stockReservation_companyRecords    StockReservation[]    @relation("StockReservation_company")
  stockMovement_companyRecords       StockMovement[]       @relation("StockMovement_company")
  orderEvent_companyRecords          OrderEvent[]          @relation("OrderEvent_company")
  delivery_companyRecords            Delivery[]            @relation("Delivery_company")
  deliveryAssignment_companyRecords  DeliveryAssignment[]  @relation("DeliveryAssignment_company")
  deliveryEvent_companyRecords       DeliveryEvent[]       @relation("DeliveryEvent_company")
  deliveryOtp_companyRecords         DeliveryOtp[]         @relation("DeliveryOtp_company")
  deliveryProof_companyRecords       DeliveryProof[]       @relation("DeliveryProof_company")
  fileAsset_companyRecords           FileAsset[]           @relation("FileAsset_company")
  proofPhoto_companyRecords          ProofPhoto[]          @relation("ProofPhoto_company")
  collection_companyRecords          Collection[]          @relation("Collection_company")
  remittance_companyRecords          Remittance[]          @relation("Remittance_company")
  remittanceItem_companyRecords      RemittanceItem[]      @relation("RemittanceItem_company")
  collectionEvent_companyRecords     CollectionEvent[]     @relation("CollectionEvent_company")
  remittanceEvent_companyRecords     RemittanceEvent[]     @relation("RemittanceEvent_company")
  subscription_companyRecords        Subscription[]        @relation("Subscription_company")
  subscriptionPayment_companyRecords SubscriptionPayment[] @relation("SubscriptionPayment_company")
  subscriptionPeriod_companyRecords  SubscriptionPeriod[]  @relation("SubscriptionPeriod_company")
  subscriptionEvent_companyRecords   SubscriptionEvent[]   @relation("SubscriptionEvent_company")
  notification_companyRecords        Notification[]        @relation("Notification_company")
  auditLog_companyRecords            AuditLog[]            @relation("AuditLog_company")

  @@index([createdAt, id])
  @@index([status, createdAt])
}

model CompanyMembership {
  organizationRole String @default("employee") @db.VarChar(30)
  employmentStatus String @default("ACTIVE") @db.VarChar(12)
  version Int @default(1)
  driverProfile DriverProfile?
  @@index([companyId,organizationRole,employmentStatus],map:"CompanyMembership_organization_idx")
  id                                  String                @id @default(uuid()) @db.Char(36)
  companyId                           String                @db.Char(36)
  userId                              String                @db.Char(36)
  roleId                              String                @db.Char(36)
  roleScope                           RoleScope             @default(COMPANY)
  active                              Boolean               @default(true)
  createdAt                           DateTime              @default(now()) @db.DateTime(3)
  updatedAt                           DateTime              @updatedAt @db.DateTime(3)
  company                             Company               @relation("CompanyMembership_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                                User                  @relation("CompanyMembership_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role                                Role                  @relation("CompanyMembership_role", fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)
  agencyMembership_membershipRecords  AgencyMembership[]    @relation("AgencyMembership_membership")
  transfer_initiatorRecords           Transfer[]            @relation("Transfer_initiator")
  transfer_carrierRecords             Transfer[]            @relation("Transfer_carrier")
  transferEvent_actorRecords          TransferEvent[]       @relation("TransferEvent_actor")
  deliveryAssignment_assignerRecords  DeliveryAssignment[]  @relation("DeliveryAssignment_assigner")
  deliveryOtp_courierRecords          DeliveryOtp[]         @relation("DeliveryOtp_courier")
  deliveryProof_courierRecords        DeliveryProof[]       @relation("DeliveryProof_courier")
  deliveryProof_authorizerRecords     DeliveryProof[]       @relation("DeliveryProof_authorizer")
  collection_verifierRecords          Collection[]          @relation("Collection_verifier")
  remittance_confirmerRecords          Remittance[]          @relation("Remittance_confirmer")
  subscriptionPayment_declarerRecords SubscriptionPayment[] @relation("SubscriptionPayment_declarer")

  @@unique([companyId, userId])
  @@unique([companyId, id])
}

model CompanyInvitation {
  kind String @default("ADMIN") @db.VarChar(10)
  staffRole String? @db.VarChar(30)
  agencyIds Json?
  @@index([companyId,kind,createdAt,id],map:"CompanyInvitation_kind_created_idx")
  id String @id @default(uuid()) @db.Char(36)
  companyId String @db.Char(36)
  email String @db.VarChar(254)
  fullName String @db.VarChar(160)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.DateTime(3)
  acceptedAt DateTime? @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  isPrimary Boolean @default(false)
  deliveryStatus String @default("PENDING") @db.VarChar(10)
  lastSentAt DateTime? @db.DateTime(3)
  createdById String @db.Char(36)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([companyId, email, acceptedAt, revokedAt])
  @@index([email, expiresAt])
  @@index([createdAt, id])
}

model Agency {
  countryCode String? @db.Char(2)
  locationNotes String? @db.VarChar(1000)
  // Composite FK to the agency affiliation is maintained in the SQL migration.
  primaryManagerUserId String? @db.Char(36)
  @@index([companyId,name,id],map:"Agency_company_name_idx")
  version Int @default(1)
  id                             String             @id @default(uuid()) @db.Char(36)
  companyId                      String             @db.Char(36)
  reference                      String             @db.VarChar(50)
  name                           String             @db.VarChar(160)
  address                        String             @db.VarChar(500)
  city                           String             @db.VarChar(120)
  zone                           String?            @db.VarChar(120)
  email                          String?            @db.VarChar(254)
  phone                          String             @db.VarChar(32)
  status                         OrganizationStatus @default(ACTIVE)
  archivedAt                     DateTime?          @db.DateTime(3)
  createdAt                      DateTime           @default(now()) @db.DateTime(3)
  updatedAt                      DateTime           @updatedAt @db.DateTime(3)
  company                        Company            @relation("Agency_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agencyMembership_agencyRecords AgencyMembership[] @relation("AgencyMembership_agency")
  stock_agencyRecords            Stock[]            @relation("Stock_agency")
  transfer_originRecords         Transfer[]         @relation("Transfer_origin")
  transfer_destinationRecords    Transfer[]         @relation("Transfer_destination")
  order_agencyRecords            Order[]            @relation("Order_agency")
  delivery_agencyRecords         Delivery[]         @relation("Delivery_agency")
  auditLog_agencyRecords         AuditLog[]         @relation("AuditLog_agency")

  @@unique([companyId, reference])
  @@unique([companyId, id])
  @@index([companyId, status])
}

model AgencyMembership {
  id                                String               @id @default(uuid()) @db.Char(36)
  companyId                         String               @db.Char(36)
  agencyId                          String               @db.Char(36)
  userId                            String               @db.Char(36)
  roleId                            String               @db.Char(36)
  roleScope                         RoleScope            @default(AGENCY)
  active                            Boolean              @default(true)
  createdAt                         DateTime             @default(now()) @db.DateTime(3)
  updatedAt                         DateTime             @updatedAt @db.DateTime(3)
  company                           Company              @relation("AgencyMembership_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership                        CompanyMembership    @relation("AgencyMembership_membership", fields: [companyId, userId], references: [companyId, userId], onDelete: Restrict, onUpdate: Restrict)
  agency                            Agency               @relation("AgencyMembership_agency", fields: [companyId, agencyId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  role                              Role                 @relation("AgencyMembership_role", fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)
  delivery_courierRecords           Delivery[]           @relation("Delivery_courier")
  deliveryAssignment_courierRecords DeliveryAssignment[] @relation("DeliveryAssignment_courier")
  collection_courierRecords         Collection[]         @relation("Collection_courier")
  remittance_courierRecords         Remittance[]         @relation("Remittance_courier")

  @@unique([companyId, agencyId, userId])
  @@unique([companyId, id])
}

model DriverProfile {
  id String @id @default(uuid()) @db.Char(36)
  companyId String @db.Char(36)
  userId String @db.Char(36)
  employeeNumber String? @db.VarChar(50)
  status String @default("ACTIVE") @db.VarChar(12)
  availability String @default("UNAVAILABLE") @db.VarChar(12)
  availabilityChangedAt DateTime @default(now()) @db.DateTime(3)
  transport String? @db.VarChar(12)
  notes String? @db.VarChar(2000)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  membership CompanyMembership @relation(fields:[companyId,userId],references:[companyId,userId],onDelete:Restrict,onUpdate:Restrict)
  @@unique([companyId,userId])
  @@unique([companyId,employeeNumber])
  @@index([companyId,status,availability])
}

model Shop {
  legalName String? @db.VarChar(160)
  description String? @db.VarChar(2000)
  countryCode String? @db.Char(2)
  city String? @db.VarChar(120)
  district String? @db.VarChar(120)
  logoKey String? @db.VarChar(80)
  registrationKey String? @unique @db.VarChar(254)
  version Int @default(1)
  termsAcceptedAt DateTime? @db.DateTime(3)
  termsVersion String? @db.VarChar(40)
  @@index([name,id])
  id                         String             @id @default(uuid()) @db.Char(36)
  reference                  String             @unique @db.VarChar(50)
  name                       String             @db.VarChar(160)
  email                      String             @db.VarChar(254)
  phone                      String             @db.VarChar(32)
  address                    String             @db.VarChar(500)
  status                     OrganizationStatus @default(ACTIVE)
  archivedAt                 DateTime?          @db.DateTime(3)
  createdAt                  DateTime           @default(now()) @db.DateTime(3)
  updatedAt                  DateTime           @updatedAt @db.DateTime(3)
  shopMembership_shopRecords ShopMembership[]   @relation("ShopMembership_shop")
  companyShop_shopRecords    CompanyShop[]      @relation("CompanyShop_shop")
  product_shopRecords        Product[]          @relation("Product_shop")
}

model ShopMembership {
  version Int @default(1)
  affiliationStatus String @default("ACTIVE") @db.VarChar(12)
  id        String    @id @default(uuid()) @db.Char(36)
  shopId    String    @db.Char(36)
  userId    String    @db.Char(36)
  roleId    String    @db.Char(36)
  roleScope RoleScope @default(SHOP)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  shop      Shop      @relation("ShopMembership_shop", fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User      @relation("ShopMembership_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role      Role      @relation("ShopMembership_role", fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)

  @@unique([shopId, userId])
}

model CompanyShop {
  origin String @default("COMPANY") @db.VarChar(12)
  version Int @default(1)
  requestedAt DateTime @default(now()) @db.DateTime(3)
  acceptedAt DateTime? @db.DateTime(3)
  suspendedAt DateTime? @db.DateTime(3)
  initiatorUserId String? @db.Char(36)
  decisionUserId String? @db.Char(36)
  reason String? @db.VarChar(500)
  observations String? @db.VarChar(1000)
  allowedAgencyIds Json?
  @@index([companyId,status,createdAt])
  id                                String              @id @default(uuid()) @db.Char(36)
  companyId                         String              @db.Char(36)
  shopId                            String              @db.Char(36)
  status                            CollaborationStatus @default(PENDING)
  startedAt                         DateTime?           @db.DateTime(3)
  endedAt                           DateTime?           @db.DateTime(3)
  createdAt                         DateTime            @default(now()) @db.DateTime(3)
  updatedAt                         DateTime            @updatedAt @db.DateTime(3)
  company                           Company             @relation("CompanyShop_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shop                              Shop                @relation("CompanyShop_shop", fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stock_collaborationRecords        Stock[]             @relation("Stock_collaboration")
  transferItem_collaborationRecords TransferItem[]      @relation("TransferItem_collaboration")
  order_collaborationRecords        Order[]             @relation("Order_collaboration")

  @@unique([companyId, shopId])
  @@unique([companyId, id])
  @@index([shopId, status])
}

model Product {
  category String? @db.VarChar(160)
  imageKey String? @db.VarChar(80)
  version Int @default(1)
  id                          String         @id @default(uuid()) @db.Char(36)
  shopId                      String         @db.Char(36)
  sku                         String?        @db.VarChar(80)
  name                        String         @db.VarChar(200)
  description                 String?        @db.Text
  unit                        String         @default("piece") @db.VarChar(30)
  weightGrams                 Int?           @db.UnsignedInt
  active                      Boolean        @default(true)
  archivedAt                  DateTime?      @db.DateTime(3)
  createdAt                   DateTime       @default(now()) @db.DateTime(3)
  updatedAt                   DateTime       @updatedAt @db.DateTime(3)
  shop                        Shop           @relation("Product_shop", fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stock_productRecords        Stock[]        @relation("Stock_product")
  transferItem_productRecords TransferItem[] @relation("TransferItem_product")
  orderItem_productRecords    OrderItem[]    @relation("OrderItem_product")

  @@unique([shopId, id])
  @@unique([shopId, sku])
}

model Session {
  clientType                String    @default("WEB") @db.VarChar(10)
  deviceName                String    @default("Navigateur") @db.VarChar(120)
  csrfHash                  String?   @db.Char(64)
  activeContext             Json?
  lastSeenAt                DateTime  @default(now()) @db.DateTime(3)
  id                        String    @id @default(uuid()) @db.Char(36)
  userId                    String    @db.Char(36)
  refreshTokenHash          String    @unique @db.Char(64)
  familyId                  String    @db.Char(36)
  expiresAt                 DateTime  @db.DateTime(3)
  revokedAt                 DateTime? @db.DateTime(3)
  replacedById              String?   @unique @db.Char(36)
  userAgent                 String?   @db.VarChar(255)
  ipHash                    String?   @db.Char(64)
  createdAt                 DateTime  @default(now()) @db.DateTime(3)
  updatedAt                 DateTime  @updatedAt @db.DateTime(3)
  user                      User      @relation("Session_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacedBy                Session?  @relation("Session_replacedBy", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session_replacedByRecords Session[] @relation("Session_replacedBy")

  @@index([userId, expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
}

model AccountToken {
  id        String       @id @default(uuid()) @db.Char(36)
  userId    String       @db.Char(36)
  purpose   TokenPurpose
  tokenHash String       @unique @db.Char(64)
  expiresAt DateTime     @db.DateTime(3)
  usedAt    DateTime?    @db.DateTime(3)
  createdAt DateTime     @default(now()) @db.DateTime(3)
  updatedAt DateTime     @updatedAt @db.DateTime(3)
  user      User         @relation("AccountToken_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, purpose, expiresAt])
}

model AuthEvent {
  id        String        @id @default(uuid()) @db.Char(36)
  userId    String?       @db.Char(36)
  type      AuthEventType
  ipHash    String?       @db.Char(64)
  metadata  Json?
  createdAt DateTime      @default(now()) @db.DateTime(3)
  user      User?         @relation("AuthEvent_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt])
}

model Stock {
  @@index([companyId, agencyId, shopId], map: "Stock_report_agency_shop_idx")
  id                            String             @id @default(uuid()) @db.Char(36)
  companyId                     String             @db.Char(36)
  shopId                        String             @db.Char(36)
  agencyId                      String             @db.Char(36)
  productId                     String             @db.Char(36)
  physicalQuantity              Int                @default(0) @db.UnsignedInt
  reservedQuantity              Int                @default(0) @db.UnsignedInt
  alertThreshold                Int                @default(0) @db.UnsignedInt
  version                       Int                @default(0) @db.UnsignedInt
  createdAt                     DateTime           @default(now()) @db.DateTime(3)
  updatedAt                     DateTime           @updatedAt @db.DateTime(3)
