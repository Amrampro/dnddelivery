NODE_ENV=development
DATABASE_ENGINE=mysql
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Required for database-backed features and /api/ready.
DATABASE_URL=mysql://example:change-me@localhost:3306/dnd_delivery
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=example
SMTP_PASSWORD=replace-me

# Optional seed price. No commercial tariff is invented.
SUBSCRIPTION_SEED_PRICE=
SUBSCRIPTION_SEED_CURRENCY=
# Dedicated disposable MySQL database for integration tests, never a production URL.
TEST_DATABASE_URL=mysql://dnd_test:example-only@127.0.0.1:3306/dnd_delivery_test

# Generate a unique random secret of at least 32 bytes.
AUTH_ACCESS_SECRET=
AUTH_ACCESS_TTL_SECONDS=600
AUTH_REFRESH_TTL_DAYS=30
AUTH_RESET_TTL_MINUTES=20
AUTH_COOKIE_SAMESITE=lax
WEB_APP_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
# SMTP_FROM is required to enable recovery. SMTP credentials stay private here.
SMTP_FROM=
SMTP_SECURE=false
# Manual one-time bootstrap only. Never set a default administrator password.
BOOTSTRAP_CONFIRM=
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=

# Bloc 5 invitations and private company logos
COMPANY_INVITATION_HOURS=48
COMPANY_LOGO_DIR=storage/company-logos
TECHNICAL_LOG_DIR=storage/technical-logs
# Optional origin used by the independently scheduled availability monitor.
API_MONITOR_URL=http://127.0.0.1:3000
PRODUCT_IMAGE_DIR=storage/product-images

# Optional pinned public key for MySQL caching_sha2_password without TLS.
# Prefer verified TLS in production; never enable unverified public-key retrieval.
DATABASE_RSA_PUBLIC_KEY_FILE=

# Bloc 13 - server-only key, at least 32 random bytes. Back up privately.
# Rotating this key invalidates existing tracking links and pending OTP secrets.
DELIVERY_SECRET=
# Private directory outside every web document root. Never serve as static files.
DELIVERY_PROOF_DIR=storage/delivery-proofs
# Requires registered native devices, EAS project and provider connectivity.
DELIVERY_PUSH_ENABLED=false
# Bloc 15 - business calendar for reports; server timestamps remain UTC.
REPORT_TIMEZONE=Africa/Douala
