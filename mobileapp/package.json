{
  "name": "dnd-delivery-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan --go",
    "start:local": "expo start --localhost --go",
    "start:tunnel": "expo start --tunnel --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --localhost",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform all",
    "doctor": "expo-doctor",
    "check:dependencies": "expo install --check",
    "start:clear": "expo start --clear --lan --go",
    "test": "tsx --test tests/*.test.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.3.0",
    "eslint": "^10.13.0",
    "expo-doctor": "^1.21.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "overrides": {
    "minimatch@>=7": "11.0.1",
    "glob@>=9": "14.0.6",
    "node-forge": "1.4.3"
  }
}
